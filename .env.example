# MoveWise AI Relocation Agent Environment Variables

# SerpApi API Key (Primary external research provider)
# Get a key from https://serpapi.com
SERPAPI_KEY=

# Google Gemini API Key (Default LLM: gemini-3.5-flash-lite)
# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional Gemini model override (defaults to gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Enable live SerpApi debug logging (true/false)
SERPAPI_DEBUG=true
